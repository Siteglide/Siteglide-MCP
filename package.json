{
  "name": "@siteglide/siteglide-mcp",
  "version": "1.0.0",
  "description": "Siteglide CLI MCP server, to help machine-based AI assistants write code on your machine to build and maintain website projects and to read and write data from your specific site. Operates with stdio over the command line. A web-based MCP will be available separately as the main Siteglide MCP in future.",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "siteglide-mcp": "./bin/siteglide-mcp.js"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "node bin/siteglide-mcp.js",
    "test": "node --test test/**/*.test.js",
    "prepublishOnly": "npm test",
    "i": "npm install -g ."
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@platformos/platformos-mcp-supervisor": "^0.2.0",
    "zod": "^3.23.8"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/siteglide/Siteglide-MCP.git"
  },
  "bugs": {
    "url": "https://feedback.siteglide.com"
  },
  "homepage": "https://siteglide.com",
  "keywords": [
    "siteglide",
    "mcp",
    "model-context-protocol",
    "platformos"
  ],
  "license": "MIT",
  "files": [
    "bin",
    "src"
  ]
}
